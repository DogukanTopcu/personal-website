# Supabase project (local: run `supabase start` and copy the API URL and anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the public site runs. Used for "View on site", preview and cache refreshes.
NEXT_PUBLIC_SITE_URL=http://localhost:3103

# Shared with the public site. Signs revalidation requests and preview links.
# Server only: never prefix it with NEXT_PUBLIC_.
REVALIDATE_SECRET=

# Optional. Further copies of the public site that read the same database (a
# staging deploy, for example), comma separated. They are refreshed after every
# save too, on a best-effort basis.
REVALIDATE_EXTRA_URLS=
